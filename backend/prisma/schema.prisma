model LeadRequest {
  id                 String    @id @default(uuid())
  orgId              String    @map("org_id")
  requestedByUserId  String    @map("requested_by_user_id")
  contactId          String    @map("contact_id")
  // 'forgotten' | 'customer_list' | 'external_sync'
  source             String
