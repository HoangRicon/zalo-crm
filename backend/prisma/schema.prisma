// ????????????????????????????????????????????????????????????????????????
// Phase 8 ? ContactEngagementDaily
// ????????????????????????????????????????????????????????????????????????
// 1 row per (Contact ? date). Aggregate per-day engagement signals cho
// heatmap UI 4-week timeline + pattern classification (hot/champion/etc).
//
// Write path:
//   - Real-time: message-handler hook (incrementDailyAggregate) on every
//     inbound/outbound message + reaction event. Upsert today's row.
//   - Daily 02:30 VN cron: recompute Contact.engagementPattern/Trend d?a
//     tr?n 28-day window, cleanup rows >12 tu?n (rolling).
//
// Read path:
//   - GET /api/v1/contacts/:id/engagement-timeline ? return 28 days
//   - Filter: conversation list l?c theo Contact.engagementPattern
//
// Daily intensity formula (capped 0-100):
//   30 ? reaction + 30 ? voiceMsg + 20 ? customerInitiated +
//   15 ? mediaShare + 5 ? inbound + 5 ? outbound (with seen)
model ContactEngagementDaily {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  contactId String   @map("contact_id")
  date      DateTime @db.Date

  // Aggregates per day
  inboundMsgCount   Int     @default(0) @map("inbound_msg_count")
  outboundMsgCount  Int     @default(0) @map("outbound_msg_count")
  reactionCount     Int     @default(0) @map("reaction_count") // KH reaction tr?n tin sale
  mediaShareCount   Int     @default(0) @map("media_share_count") // KH g?i ?nh/video/file/voice/location/...
  voiceMsgCount     Int     @default(0) @map("voice_msg_count") // KH g?i voice (subset c?a media)
  callCount         Int     @default(0) @map("call_count") // KH g?i voice/video ? duration > 0 (connected)
  missedCallCount   Int     @default(0) @map("missed_call_count") // KH g?i nh? ? duration = 0 (intent y?u h?n)
  quoteReplyCount   Int     @default(0) @map("quote_reply_count") // KH quote-reply 1 tin c?a sale (signal m?nh)
  customerInitiated Boolean @default(false) @map("customer_initiated") // KH nh?n tr??c trong ng?y

  // Derived intensity 0-100 (heatmap cell color)
  dailyIntensity Int @default(0) @map("daily_intensity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([orgId, contactId, date])
  @@index([orgId, contactId, date(sort: Desc)])
  @@index([orgId, date])
  @@map("contact_engagement_daily")
}

