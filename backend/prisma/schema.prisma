// ???????????????????????????????????????????????????????????????????????????
// Broadcast t? ??ng (Community extension) 2026-07-06
// G?i tin h?ng lo?t t?i T?p kh?ch h?ng (CustomerList) theo l?ch:
//   once (1 l?n) | daily (h?ng ng?y) | weekly (ng?y trong tu?n).
// Worker cron g?i R?I TIN (pacing delaySecMin..Max) qua zaloOps (rate-limiter
// SdkLimit gate th?m 1 l?p). KH?NG khai b?o FK relation sang Organization/
// CustomerList/ZaloAccount ?? kh?ng ??ng model core ? validate ? route.
// ???????????????????????????????????????????????????????????????????????????

model BroadcastJob {
  id             String  @id @default(uuid())
  orgId          String  @map("org_id")
  createdById    String  @map("created_by_id")
  name           String
  // Ngu?n ng??i nh?n: 'customer_list' ? customerListId (S?T trong t?p ? c? th? l?
  // NG??I L? ch?a k?t b?n, tin d? v?o h?p "ng??i l?"/b? ch?n); 'friends' ? to?n b?
  // B?n b? ?? k?t b?n (Friend.friendshipStatus='accepted') c?a nick g?i ? an to?n,
  // tin v?o th?ng h?p chat. M?c ??nh customer_list (gi? t??ng th?ch job c?).
  sourceType     String  @default("customer_list") @map("source_type") // 'customer_list' | 'friends'
  customerListId String? @map("customer_list_id") // t?p KH ??ch (khi sourceType=customer_list)
  zaloAccountId  String  @map("zalo_account_id") // nick g?i (primary)
  // 2026-07-22: Multi-account broadcast
  zaloAccountIds Json?   @map("zalo_account_ids") // array of account IDs (when > 1)
  sendMode       String? @map("send_mode") // 'duplicate' | 'round_robin'

  // N?i dung: text h? tr? bi?n {{ten}} {{sdt}}; ?nh k?m (URL media MinIO/S3, optional).
  // N?u contentBlockIds kh?ng r?ng ? b? qua messageText/imageUrl, xoay v?ng n?i dung
  // t? ContentBlock (spin content ch?ng spam) ? m?i tin g?i l?y 1 block k? ti?p theo th? t?.
  messageText     String   @map("message_text") @db.Text
  imageUrl        String?  @map("image_url")
  contentBlockIds String[] @default([]) @map("content_block_ids")

  // L?ch: 'once' ? scheduledAt; 'daily' ? timeOfDay; 'weekly' ? daysOfWeek + timeOfDay
  scheduleType String    @map("schedule_type") // 'once' | 'daily' | 'weekly'
  scheduledAt  DateTime? @map("scheduled_at")
  timeOfDay    String?   @map("time_of_day") // "HH:mm" gi? VN (UTC+7)
  daysOfWeek   Int[]     @default([]) @map("days_of_week") // 0=CN..6=T7 (JS getDay)

  // Ch?ng block: tr?n m?i l?n ch?y + gi?n c?ch ng?u nhi?n gi?a 2 tin
  maxPerRun   Int @default(50) @map("max_per_run")
  delaySecMin Int @default(30) @map("delay_sec_min")
  delaySecMax Int @default(90) @map("delay_sec_max")

  status    String    @default("active") // 'active' | 'paused' | 'done'
  nextRunAt DateTime? @map("next_run_at")
  lastRunAt DateTime? @map("last_run_at")

  // Sprint 2 R4 2026-07-21: A/B test mode. M?c ??nh 'off' (gi? t??ng th?ch job c?).
  // 'ab_split' = chia ??u KH cho 2-3 variants, m?i variant l?u messageText ri?ng.
  // Variant A = messageText (existing). Variant B, C = variantMessageTexts[0], [1].
  abMode              String? @map("ab_mode") // 'off' | 'ab_split'
  abVariantCount      Int?    @map("ab_variant_count") // 2 | 3 (khi abMode='ab_split')
  variantMessageTexts Json?   @map("variant_message_texts") // JSON array<string> cho variants B, C

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  runs BroadcastRun[]

  @@index([orgId, status])
  @@index([status, nextRunAt])
  @@map("broadcast_jobs")
}

model BroadcastRun {
  id    String       @id @default(uuid())
  jobId String       @map("job_id")
  job   BroadcastJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  orgId String       @map("org_id")

  status       String    @default("running") // 'running' | 'done' | 'error'
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  lastSentAt   DateTime? @map("last_sent_at") // pacing: ch? g?i ti?p khi ?? qua delay
  sentCount    Int       @default(0) @map("sent_count")
  failedCount  Int       @default(0) @map("failed_count")
  skippedCount Int       @default(0) @map("skipped_count")
  error        String?

  items BroadcastRunItem[]

  @@index([jobId])
  @@index([orgId, status])
  @@map("broadcast_runs")
}

model BroadcastRunItem {
  id    String       @id @default(uuid())
  runId String       @map("run_id")
  run   BroadcastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orgId String       @map("org_id")

  entryId String  @map("entry_id") // CustomerListEntry.id
  phone   String?
  name    String?
  zaloUid String? @map("zalo_uid")
  // 2026-07-26: nick thực sự gửi (multi-acc round-robin). Nullable cho backward-compat
  // với item cũ chỉ dùng job.zaloAccountId.
  zaloAccountId String? @map("zalo_account_id")

  status    String // 'sending' (claim P4) | 'sent' | 'failed' | 'skipped'
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Sprint 2 R4 2026-07-21: Reply tracking + A/B group.
  // replyMessageId = Message.id c?a tin KH reply ??u ti?n sau broadcast.
  // repliedAt = th?i ?i?m reply (set 1 l?n ? reply ti?p theo KH?NG update).
  // Window reply = 7 ng?y (sau ?? coi nh? kh?ng li?n quan).
  // abGroupId = 'A' | 'B' | 'C' | null (ch? set khi job.abMode='ab_split').
  replyMessageId String?   @map("reply_message_id")
  repliedAt      DateTime? @map("replied_at")
  abGroupId      String?   @map("ab_group_id") @db.VarChar(2)

  // P6 (E3/C4) ? unique(runId, entryId): 1 recipient ch? ghi 1 l?n/run. N?n t?ng cho
  // P4 (claim-before-send): create row 'sending' TR??C khi g?i Zalo, P2002 = ?? c? tick
  // kh?c g?i ? b?. Ch?n c? race 2 tick/2 instance. (unique ?? bao g?m index cho query dedup.)
  @@unique([runId, entryId])
  // Index cho query aggregation A/B (responseRate per group) + heatmap (group by hour/day)
  @@index([runId, abGroupId])
  @@index([orgId, repliedAt])
  @@map("broadcast_run_items")
}

