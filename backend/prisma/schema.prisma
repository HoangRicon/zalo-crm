// Block ? atomic content/action unit. ENTITY TRUNG T?M:
// ???c Sequence.steps[].blockId, Broadcast.blockId, Trigger.blockId tham chi?u.
// `content` JSON shape theo `actionType`:
//   request_friend  ? { greetingVariants: string[] }
//   send_message    ? { textVariants: string[], attachments?: [{ kind, url, caption? }] }
//   update_status   ? { statusId: string, condition?: {...} }
// `isShared`: false = ch? owner d?ng (block c? nh?n c?a sale), true = m?i sale d?ng.
// `usageCount` cache ?? UI hi?n badge "?ang d?ng trong N sequence/broadcast".
// `archivedAt`: soft delete ? block b? archive v?n gi? snapshot trong task ?ang ch?y.
model Block {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  folderId         String?   @map("folder_id")
  name             String
  channel          String    @default("zalo_user")
  actionType       String    @map("action_type") // 'request_friend' | 'send_message' | 'update_status' | ...
  content          Json      @default("{}")
  ownerNickId      String?   @map("owner_nick_id")
  // 2026-06-04: isShared DEPRECATED ? visibility l?n Folder. Gi? field ?? migrate dual-read 2 tu?n.
  isShared         Boolean   @default(true) @map("is_shared")
  tagIds           String[]  @default([]) @map("tag_ids") // 2026-06-04 ? d? ?n/m?c ??ch, multi free-form
  usageCount       Int       @default(0) @map("usage_count")
  lastUsedAt       DateTime? @map("last_used_at")
  // 2026-06-07 ? ??m RI?NG s? l?n sale G?I TAY Kh?i t? chat (KH?NG t?nh automation/sequence).
  // usageCount g?p c? 2 ngu?n; manualSendCount ch? t?ng ? endpoint /conversations/:id/send-block.
  manualSendCount  Int       @default(0) @map("manual_send_count")
  lastManualSentAt DateTime? @map("last_manual_sent_at")
  archivedAt       DateTime? @map("archived_at")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder        BlockFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ownerNick     ZaloAccount?   @relation("BlockOwnerNick", fields: [ownerNickId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("BlockCreatedBy", fields: [createdById], references: [id])
  sequenceSteps SequenceStep[]
  // tasks  AutomationTask[]  ? REMOVED 2026-06-01 Lu?ng M?c Ti?u M0

  @@index([orgId, channel, actionType])
  @@index([orgId, archivedAt])
  @@index([folderId])
  @@index([tagIds], type: Gin)
  @@map("blocks")
}

// SequenceStep ? 2026-06-04 Anh ch?t: t?ch JSON blob ra table ri?ng.
// Tr??c: AutomationSequence.steps Json @default("[]") ? archive Block silent break Sequence.
// Sau: FK Block th?t. Worker dual-read: ?u ti?n sequenceSteps[], fallback steps Json 2 tu?n.
model SequenceStep {
  id            String   @id @default(uuid())
  sequenceId    String   @map("sequence_id")
  blockId       String?  @map("block_id") // nullable: step c? th? ch?a pick Block (draft)
  stepOrder     Int      @map("step_order")
  delayMinutes  Int      @default(0) @map("delay_minutes")
  // 2026-06-19 (g?p Lu?t 2 v?o step) ? jitter ? ph?t random quanh delayMinutes (ch?ng bot). 0 = t?t.
  jitterMinutes Int      @default(0) @map("jitter_minutes")
  exitCondition Json?    @map("exit_condition") // {type: 'replied'|'clicked'|'timeout', value?}
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sequence AutomationSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  block    Block?             @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@unique([sequenceId, stepOrder])
  @@index([blockId])
  @@map("sequence_steps")
}

// Sequence ? multi-step drip flow. `steps` l? array c? c?u tr?c:
//   [{ stepId, blockId, delayMinutes, exitCondition? }, ...]
// Delay t?nh t? th?i ?i?m step tr??c ho?n th?nh. delayMinutes=0 cho step ??u.
// `runtimeRules` (ch?t t? memory):
//   { allowedHourRange: [6, 22],
