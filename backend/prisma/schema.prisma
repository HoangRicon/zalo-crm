  // L?i m?i / tin nh?n ri?ng cho entry n?y ? d?ng khi g?i friend-request ho?c message
  // Ch? map t? CSV/Excel column "Ghi ch?". Paste tab KH?NG c? (ch? phone+name).
  // T?n field c? ? KH?NG l? `notes` ?? tr?nh nh?m v?i Contact.notes (CRM internal notes).
  personalNote String? @map("personal_note")

  // 2026-05-20: 2-axis status refactor.
  // Lifecycle (5 state) ??c t? `status` + `hasZalo`:
  //   M?i ? entry v?a insert (status=pending/validated, ch?a qua worker)
  //   ?ang ch? Qu?t ? ?? validate ho?c Friend check no-match (status=validated|enriched + hasZalo=null)
  //   C? Zalo ? hasZalo=true
  //   Kh?ng c? Zalo ? hasZalo=false (CH? Campaign SDK 404 confirm)
  //   L?i ? status=invalid (parse fail)
  //
  // systemMessages = append-only stack c?c s? ki?n ??c th? (tr?ng list X, ?? CRM,
  // sale lo?i, s? sai format c? th?, ...). Newest top, hover xem full.
  // Race-safe append qua raw SQL: jsonb_array_append(system_messages, $event::jsonb).
  // KH?NG d?ng ?? filter ch?nh (d?ng dup_*_id index ri?ng) ? ch? for display.
  systemMessages Json @default("[]") @map("system_messages")

  // Normalized phone variants
  phoneE164     String? @map("phone_e164") // "+84908123456"
  phoneLocal    String? @map("phone_local") // "0908123456" ? Vietnamese local format
  phoneValid    Boolean @default(false) @map("phone_valid")
  invalidReason String? @map("invalid_reason") // 'too_short' | 'invalid_format' | 'empty' | 'invalid_prefix'

  // Linkage to created Contact (if h?p l? + not skipped)
  contactId String? @map("contact_id")

  // Zalo enrichment ? populated by reverse-update from 3 event sources
  zaloUid          String?  @map("zalo_uid") // UID per nick
  zaloGlobalId     String?  @map("zalo_global_id") // cross-nick identity
  zaloName         String?  @map("zalo_name") // display name t? Zalo SDK
  resolvedByNickId String?  @map("resolved_by_nick_id") // ZaloAccount n?o t?m ra UID n?y
  multiNickCount   Int      @default(0) @map("multi_nick_count") // s? nick kh?c c?ng t?m ra
  hasZalo          Boolean? @map("has_zalo") // null=ch?a scan, true/false=?? scan

  // Dedup flags
  dupInListWithEntryId String? @map("dup_in_list_with_entry_id")
  dupWithListId        String? @map("dup_with_list_id")
  dupWithListEntryId   String? @map("dup_with_list_entry_id")
  dupWithContactId     String? @map("dup_with_contact_id")

  // State machine:
  //   pending ? validated ? [contact_created | dup_in_list | dup_cross_list |
  //   dup_with_crm | invalid] ? enriched (has_zalo true/false)
  status       String    @default("pending")
  errorMessage String?   @map("error_message")
  enrichedAt   DateTime? @map("enriched_at")

  // Phase Multi-Source Lead Ads 2026-05-27 ? schemaless l?u form fields bi?n ??ng
  // (m?i form FB/TikTok/Google c? s? c?u h?i kh?c nhau). customFields = answers t?
  // form lead-gen, sourceMeta = audit trail (campaignId, adId, formId, pageId,
  // leadId, deliveredAt, latencyMs...) ?? debug + analytics.
  customFields Json? @map("custom_fields")
  sourceMeta   Json? @map("source_meta")

  // #2 2026-06-06 (Anh ch?t) ? TO?N B? c?t h?ng ??i + M9 override ?? T?CH sang b?ng
  // n?i TriggerQueueEntry (per-trigger, m?i M?c ti?u ??c l?p). CustomerListEntry gi?
  // ch? gi? data kh?ch per-t?p (phone, zalo*, hasZalo, contactId, dup, status...).

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // #2 2026-06-06 ? h?ng ??i t?ch sang b?ng n?i per-trigger.
  queueRows TriggerQueueEntry[]

  // ?? Facebook Lead Ads "Form" metadata 2026-06-09 (port t? main) ??????????
  // C?t ri?ng cho lead v?o qua FB Lead Form (KH?C lu?ng Campaign d?ng sourceMeta JSON).
  fbLeadgenId     String?  @map("fb_leadgen_id")
  fbAdId          String?  @map("fb_ad_id")
  fbAdName        String?  @map("fb_ad_name")
