// Phase Lead Pool FIFO 2026-06-15 ? s? ph?t lead. M?i l?n chia 1 d?ng.
// D?ng cho view "Nh?t k? chia" + ??m s? l?n. KH?NG thay LeadRequest (lo note/return).
// Ngu?n s? th?t cho "?? chia m?y l?n" = Contact.pooledCount / c?t round, KH?NG ??m
// COUNT(*) b?ng n?y (ch? ghi t? l?c deploy, lead c? thi?u).
model LeadPoolDistribution {
