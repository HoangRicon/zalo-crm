  welcomeFailedCount Int       @default(0) @map("welcome_failed_count")
  lastWelcomeAt      DateTime? @map("last_welcome_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items TargetRunItem[]

  @@index([orgId, status])
  @@map("target_jobs")
}

model TargetRunItem {
  id    String    @id @default(uuid())
  jobId String    @map("job_id")
  job   TargetJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  orgId String    @map("org_id")

  entryId String  @map("entry_id") // CustomerListEntry.id (customer_list) ho?c GroupMember.id (group_scan)
  phone   String?
  name    String?
  zaloUid String? @map("zalo_uid")

  status    String // 'sent' | 'no_zalo' | 'failed' | 'skipped'
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Tin ch?o (v?ng 6): contactId ?? ??i chi?u FriendshipAttempt.state='accepted'.
  // welcomeStatus: null (job kh?ng b?t ch?o) | 'waiting' | 'sent' | 'failed'
  contactId     String?   @map("contact_id")
  welcomeStatus String?   @map("welcome_status")
  welcomeSentAt DateTime? @map("welcome_sent_at")
  welcomeError  String?   @map("welcome_error")

  @@index([jobId, entryId])
  @@index([jobId, welcomeStatus])
  @@map("target_run_items")
}

// ---------------------------------------------------------------------------
// Churn Risk Score (Sprint 3 R9 ? 2026-07-21)
// Cron nightly 02:00 VN qu?t contact cooling/cold trong 14-90 ng?y,
// g?i AI (ho?c rule-based fallback) ch?m di?m r?i ro r?i b?.
// Dashboard widget hi?n th? top 10 high risk.
// expiresAt = scoredAt + 24h ? cache TTL, cron rerun t?o row m?i.
// ---------------------------------------------------------------------------

model ChurnRiskScore {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  contactId       String   @map("contact_id")
  riskLevel       String   @map("risk_level") // 'low' | 'medium' | 'high'
  reasons         Json     @map("reasons") // string[] ? l? do ng?n g?n
  suggestedAction String?  @map("suggested_action") @db.Text
  source          String   @map("source") // 'ai' | 'rule_based'
  scoredAt        DateTime @default(now()) @map("scored_at")
  expiresAt       DateTime @map("expires_at") // scoredAt + 24h

  @@index([orgId, riskLevel, scoredAt])
  @@index([expiresAt])
  @@map("churn_risk_scores")
}

