  leadBonusReceived         LeadPoolBonusQuota[]         @relation("LeadPoolBonusRecipient")
  leadBonusGranted          LeadPoolBonusQuota[]         @relation("LeadPoolBonusGranter")
  leadDistributionsReceived LeadPoolDistribution[]       @relation("LeadDistributionRecipient")
  // Phase Privacy OTP 2026-05-27
  privacyOtpTokens          PrivacyOtpToken[]            @relation("PrivacyOtpUser")
  // M53 (2026-05-30): AI suggestions sale applied
  aiSuggestionsApplied      AiSuggestionApplied[]
  // Phase 2 b?o m?t 2026-06-08 ? refresh token rotation
  refreshTokens             RefreshToken[]
  // Mobile App 2026-06-15 ? thi?t b? nh?n push (FCM/APNs)
  devices                   Device[]
  // Phase FB Lead Ads "Form" 2026-06-09 ? round-robin chia lead cho sale.
  customerListAssignments   CustomerListSaleAssignment[]
  // Phase Media Library 2026-06-11 ? kho ph??ng ti?n (owner + ng??i t?o).
  ownedMediaAssets          MediaAsset[]                 @relation("MediaAssetOwner")
  createdMediaAssets        MediaAsset[]                 @relation("MediaAssetCreatedBy")
  ownedMediaAlbums          MediaAlbum[]                 @relation("MediaAlbumOwner")
  createdMediaAlbums        MediaAlbum[]                 @relation("MediaAlbumCreatedBy")

  @@map("users")
}

// Phase 2 b?o m?t x?c th?c 2026-06-08 ? refresh token rotation.
// Access token s?ng ng?n (15'); refresh token opaque random s?ng d?i (30d),
// L?U HASH (sha256) ch? kh?ng l?u plaintext. M?i l?n d?ng -> xoay (single-use):
// c?p token m?i c?ng familyId, ??nh d?u token c? usedAt + replacedById.
// Reuse-detection: token ?? d?ng (ngo?i grace window) b? g?i l?i -> coi l? ??nh
// c?p -> revoke C? family. KH?NG c? c?t org_id -> kh?ng d?nh RLS (lookup theo
// tokenHash ch?y pre-auth khi ch?a bi?t org).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  // sha256(token) hex ? kh?ng bao gi? l?u plaintext.
  tokenHash    String    @unique @map("token_hash")
  // Nh?m xoay v?ng: m?i token sinh t? m?t l?n login chia s? familyId.
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  // usedAt != null -> ?? xoay (single-use). revokedAt != null -> b? thu h?i.
  usedAt       DateTime? @map("used_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  // Device/session binding metadata (#7).
  createdIp    String?   @map("created_ip")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Zalo account linked to a user (one user may own multiple Zalo accounts)
model ZaloAccount {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  ownerUserId      String    @map("owner_user_id")
  zaloUid          String?   @unique @map("zalo_uid")
  displayName      String?   @map("display_name")
  avatarUrl        String?   @map("avatar_url")
  phone            String?
  status           String    @default("disconnected") // connected, disconnected, qr_pending
  proxyUrl         String?   @map("proxy_url") // per-account proxy (PR#11)
  sessionData      Json?     @map("session_data")
  lastConnectedAt  DateTime? @map("last_connected_at")
  // 2026-06-16 (Anh ch?t): ph?n bi?t NG?T TH? C?NG vs M?T K?T N?I TH? ??NG.
  //   disconnectedAt    = th?i ?i?m nick r?i tr?ng th?i connected (m?c ?? FE ??m/hi?n th?).
  //   disconnectReason  = 'manual' (sale b?m Ng?t ? KH?NG t? reconnect, hi?n "?? ng?t l?c {gi?}")
  //                     | 'passive' (nick r?t do Zalo/m?ng ? FE ??m ph?t:gi?y t?ng) | null (?ang connected).
  // Cron health-check + autoReconnect B? QUA nick disconnectReason='manual' (ng?t l? ng?t th?t).
  disconnectedAt   DateTime? @map("disconnected_at")
  disconnectReason String?   @map("disconnect_reason")
  // Phase Ri?ng T? 2026-05-22: sale g?n nick l? 'main' ? blur content cho user kh?c,
  // ch? owner unlock PIN xem ???c. Default 'sub' (org public). Xem design doc:
  // ~/.gstack/projects/zalocrm/thanh-private-mode-design-20260521.md
  privacyMode      String    @default("sub") @map("privacy_mode")
  // 2026-06-09 (Anh ch?t): x?a M?M ? sale/admin x?a nick kh?i danh s?ch nh?ng GI?
  // d? li?u (h?i tho?i/tin/b?n b?) trong DB. archivedAt != null = ?? ?n kh?i danh s?ch.
  // Listener + health-check B? QUA nick ?? archive (kh?ng reconnect).
  archivedAt       DateTime? @map("archived_at")
  // T13 (2026-06-21): user.id ng??i b?m X?A nick (null = h? th?ng t? d?n th? ma / x?a tr??c khi
  // c? field n?y). Tab "Nick ?? x?a" resolve t?n qua User. KH?NG FK (gi? nh?, x?a user ko cascade).
  archivedById     String?   @map("archived_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Sprint 2 R4 2026-07-21: Blacklist nick cho Broadcast.
  // Khi true, cron broadcast SKIP job c? zaloAccountId=this (ch? skip, kh?ng reject job ? admin c? th? re-enable).
  // Reason optional, l?u l? do (vd "B? Zalo rate-limit 3 l?n trong tu?n") ?? audit.
  broadcastBlacklisted     Boolean @default(false) @map("broadcast_blacklisted")
  broadcastBlacklistReason String? @map("broadcast_blacklist_reason") @db.Text

  org                Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner              User                  @relation(fields: [ownerUserId], references: [id])
  access             ZaloAccountAccess[]
  conversations      Conversation[]
  dailyStats         DailyMessageStat[]
  friendshipAttempts FriendshipAttempt[]
  friends            Friend[]
  zaloLabelsList     ZaloLabel[]
  crmTagGroups       CrmTagGroup[]
  // Phase 6+ ? Inbox Triage Filter (junction folder membership)
