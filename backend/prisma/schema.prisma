// #2 2026-06-06 (Anh ch?t) ? B?NG N?I h?ng ??i per-M?c-ti?u.
// M?i M?c ti?u (trigger) ??c l?p ho?n to?n v? kh?ch, KH?NG ch?ng tr?ng: 1 kh?ch
// (CustomerListEntry) c? th? c? N h?ng ? m?i trigger 1 h?ng, m?i h?ng 1 tr?ng th?i
// x? l? ri?ng. Tr??c ??y c?c c?t n?y n?m th?ng tr?n CustomerListEntry n?n 1 kh?ch ch?
// thu?c 1 trigger ? 2 M?c ti?u chung t?p tranh nhau. T?ch ra ??y ?? ch?y song song.
// Denormalize orgId/customerListId/contactId ?? claim/sweeper/sticky-hold query nhanh
// (sticky-hold + chat-handler filter theo contactId, kh?ng theo entryId).
model TriggerQueueEntry {
  id                  String  @id @default(uuid())
  triggerId           String  @map("trigger_id")
  customerListEntryId String  @map("customer_list_entry_id")
  // Denormalized scope keys (??c/where nhanh kh?ng c?n JOIN entry).
  orgId               String  @map("org_id")
  customerListId      String  @map("customer_list_id")
  contactId           String? @map("contact_id")

  // ?? H?ng ??i (di d?i t? CustomerListEntry) ??
  queueStatus        String    @default("queued_for_pickup") @map("queue_status")
  claimedByNickId    String?   @map("claimed_by_nick_id")
  lockedAt           DateTime? @map("locked_at")
  failedNickIds      Json      @default("[]") @map("failed_nick_ids") @db.JsonB
  stuckRecoveryCount Int       @default(0) @map("stuck_recovery_count")
  rateLimitCount     Int       @default(0) @map("rate_limit_count")
  nickHoldSince      DateTime? @map("nick_hold_since")
  restartCycle       Int       @default(0) @map("restart_cycle")
  lastResetReason    String?   @map("last_reset_reason")

  // ?? M9 manual-enroll override (di d?i ? per-trigger, Anh ch?t d?i) ??
  sequenceIdOverride String?   @map("sequence_id_override")
  nickIdOverride     String?   @map("nick_id_override")
  enrolledBy         String?   @map("enrolled_by")
  enrollReason       String?   @map("enroll_reason")
  enrolledAt         DateTime? @map("enrolled_at")
  manualEnrollMeta   Json?     @map("manual_enroll_meta")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trigger AutomationTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  entry   CustomerListEntry @relation(fields: [customerListEntryId], references: [id], onDelete: Cascade)

  @@unique([triggerId, customerListEntryId]) // 1 c?p = 1 h?ng ??i
  @@index([queueStatus, triggerId]) // dashboard groupBy + completion sweeper
  @@index([queueStatus, lockedAt]) // stuck sweeper
  @@index([claimedByNickId, queueStatus]) // sticky-hold disconnect/reconnect
  @@index([nickHoldSince]) // sticky-hold sweeper
  @@index([triggerId, contactId]) // chat-handler + accept/reject theo contact
  @@index([customerListEntryId]) // join entry?queue cho dashboard
  @@map("trigger_queue_entries")
}

// ????????????????????????????????????????????????????????????????????????
// CARESESSION (Phi?n ch?m s?c) ? 2026-06-07
// T?ch l?p L?NG NGHE s? ki?n kh?ch + NH?C sale kh?i trigger/sequence engine.
// Spec: ~/.gstack/projects/locphamnguyen-ZaloCRM/EVO-THANH-private-hs-design-engagement-session-20260607-023703.md
//
//   ?? T?O ???????????????????????????????????????????????????????????????
//   ? Kh?ch v?o lu?ng (trigger auto HO?C g?n tay) ? INSERT CareSession    ?
//   ? (Postgres = CH?N L?, D2) ? enqueue BullMQ sequence SAU ? reconcile  ?
//   ??????????????????????????????????????????????????????????????????????
//   ?? NGHE (listener) ???????????????????????????????????????????????????
//   ? Tin/reaction/friend-event c?a KH ? query phi?n ?ANG M?              ?
//   ? (orgId,contactId,nickId) JOIN trigger.state (D10).                  ?
//   ? allowlist NGHE = [active, paused] (D12: paused V?N nghe!).          ?
//   ? ngu?n ? [completed,cancelling,cancelled] ? lazy-close + b? qua.     ?
//   ? ? reset interestWindowUntil + pause lu?ng + b?n notify.             ?
//   ??????????????????????????????????????????????????????????????????????
//   ?? ??NG (B?T K? c?i n?o t?i tr??c) ???????????????????????????????????
//   ? ? ngu?n completed/cancelled (cascade ho?c lazy-close)               ?
//   ? ? ??t status/tag trong closeConditions (event-driven, ??ng ngay)    ?
//   ? ? kh?ch ch?n                                                        ?
//   ? ? janitor: im l?ng qu? interestWindowUntil (set-based UPDATE, D5)   ?
//   ??????????????????????????????????????????????????????????????????????
// ????????????????????????????????????????????????????????????????????????

model CareSession {
  id    String @id @default(uuid())
  orgId String @map("org_id")

  // ?? Kh?a nh?n di?n (lookup phi?n m? theo tuple n?y, c? index) ??
  contactId        String  @map("contact_id")
  nickId           String  @map("nick_id")
  // Per-nick UID c?a kh?ch (g?c nh?n nick sale ? nick kh?ch) = Conversation.externalThreadId
  // = Friend.zaloUidInNick. Anh ch?t 2026-06-08: phi?n neo theo (nick, thread) ?? 1 nick c?
  // 2 h?i tho?i c?ng 1 Contact CHA v?n t?ch phi?n ??ng. NULLABLE: phi?n c? + phi?n no-Zalo
  // (virtual) ?? null ? listener fallback "OR null" (kh?p m?i thread) ?? kh?ng v? phi?n c?.
  externalThreadId String? @map("external_thread_id")

  // ?? S? h?u / ngu?n ??
  ownerUserId      String  @map("owner_user_id") // sale ph? tr?ch (ch? nick) ? ng??i H?NH ??NG
  enrolledByUserId String? @map("enrolled_by_user_id") // ai g?n tay (manager) ? null n?u auto
  sourceType       String  @map("source_type") // 'trigger' | 'sequence_manual'
  sourceTriggerId  String? @map("source_trigger_id")
  sourceSequenceId String? @map("source_sequence_id")

  // ?? V?ng ??i ??
  state                   String    @default("active") // 'active' | 'closed'
  closedReason            String?   @map("closed_reason") // 'source_done'|'sale_resolved'|'customer_blocked'|'janitor_silence'|'deal_won'|'stranger_blocked'|'completed'
  // Snapshot ?i?u ki?n ??ng t? trigger.closeConditions l?c t?o (m?i phi?n lu?t ri?ng).
  closeConditions         Json?     @map("close_conditions")
  // C?a s? im l?ng: RESET m?i event kh?ch (D13 ? reset m?i event, kh?ng ch?n abuse).
  interestWindowUntil     DateTime  @map("interest_window_until")
  lastCustomerActivityAt  DateTime? @map("last_customer_activity_at")
  // CareSession 2026-06-07 (anh ch?t): hi?n th? pause cho sale ? trang Phi?n ch?m s?c.
  //   lastReplyAt  = KH tr? l?i l?n cu?i l?c n?o (badge "?? V?a tr? l?i X ph?t tr??c").
  //   pausedUntil  = lu?ng b?m ?u?i t?m d?ng t?i khi n?o (badge "? ch?y l?i sau X gi?").
  //                  ??ng b? v?i Redis pause flag (contact:paused TTL) ? ngu?n hi?n th?.
  lastReplyAt             DateTime? @map("last_reply_at")
  pausedUntil             DateTime? @map("paused_until")
  // D2 reconcile marker: ?? enqueue BullMQ start ch?a (tr?nh enqueue tr?ng / m? c?i).
  sequenceStartEnqueuedAt DateTime? @map("sequence_start_enqueued_at")

  // ?? Sequence recode ??t 1 (2026-06-13) ? lu?t 4 pause/resume, c?t m?m nullable ??
  // pausedAtStepIdx: b??c ?ang d? khi KH reply (pause). Resume worker ??c c?t n?y ??
  // re-enqueue ??NG b??c c?a ??NG lu?ng (per-CareSession theo sourceSequenceId). NULL =
  // kh?ng ?ang pause-gi?a-ch?ng. Clear sau khi resume re-enqueue xong.
  pausedAtStepIdx Int?  @map("paused_at_step_idx")
  // pauseEpoch: t?ng m?i l?n KH reply (pause). Resume ch? re-enqueue n?u epoch kh?p l?c
  // pause ? ch?ng "close c? h?i sinh send sau reply m?i" (Codex #2). NULL/0 = ch?a pause.
  pauseEpoch      Int?  @map("pause_epoch")
  // enrollEpoch (2026-06-15): S? L?N g?n lu?ng n?y cho KH ? g?n l?i t?ng epoch ? jobId m?i
  // (kh?ng ??ng job c? ?? completed). Resume/cancel d?ng ??ng epoch c?a l?n g?n n?y. NULL=1.
  enrollEpoch     Int?  @map("enroll_epoch")
  // rulesSnapshot: ch?p runtimeRules (gi?/sendGap/cooldown) l?c enroll ? ??i c?u h?nh
  // KH?NG ?nh h??ng KH ?ang ch?y (Codex #10). NULL = d?ng rules live c?a sequence (fallback).
  rulesSnapshot   Json? @map("rules_snapshot")

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  org     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  trigger AutomationTrigger? @relation(fields: [sourceTriggerId], references: [id], onDelete: SetNull)
  events  CareSessionEvent[]

  // Lookup phi?n m? cho listener (hot-path) ? tuple + state.
  @@index([orgId, contactId, nickId, state])
  // Lookup theo (nick, thread) cho UI/SDK + per-conversation precision (2026-06-08).
  @@index([nickId, externalThreadId])
  // Janitor qu?t im-l?ng ??n h?n (D5: state + window).
  @@index([state, interestWindowUntil])
  // Cascade close + reconcile theo ngu?n trigger.
  @@index([sourceTriggerId, state])
  // List "Phi?n ch?m s?c" theo sale (RBAC scope, D-frontend).
  @@index([orgId, ownerUserId, state])
  @@map("care_sessions")
}

// CareSessionEvent ? append-only event log c?a phi?n. Unique (sessionId, eventId)
// L? c? ch? idempotency ch?ng double-process (D4): INSERT tr?ng ? bi?t ?? x? l?.
model CareSessionEvent {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  // eventId chu?n h?a (D-notify): nickId:contactId:eventType:<providerMsgId|reactionId|timestampBucket>.
  // Ph?n t?n (UUID-ish), KH?NG sequential per-session ? tr?nh hot unique-index (audit S2).
  eventId   String   @map("event_id")
  eventType String   @map("event_type") // 'reply'|'reaction_pos'|'reaction_neg'|'friend_accept'|'friend_reject'|'blocked'|'opened'|'paused'|'notified'|'closed'
  payload   Json? // n?i dung tin / emoji (??a v?o notify)
  createdAt DateTime @default(now()) @map("created_at")

  session CareSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, eventId]) // idempotency gate
  @@index([sessionId, createdAt]) // timeline per-phi?n
  @@map("care_session_events")
}

// ????????????????????????????????????????????????????????????????????????
// RBAC PHASE PH?N QUY?N ? 2026-05-21
// Department tree (org structure) + PermissionGroup tree (what actions)
// Reference: GetflyCRM model. Decisions locked ?
// ~/.gstack/projects/zalocrm/thanh-rbac-m2-design-20260521.md
// ????????????????????????????????????????????????????????????????????????

model Department {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  name         String
  parentId     String?   @map("parent_id")
  // Materialized path "/<rootId>/<midId>/<thisId>/" ? query subtree b?ng LIKE.
  // Auto recompute b?i trigger Postgres recompute_department_path() khi insert/update parent_id.
  path         String
  depth        Int       @default(0) // 0 = root, max 4 (5 level total per anh ch?t)
  displayOrder Int       @default(0) @map("display_order")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Department?        @relation("DeptTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Department[]       @relation("DeptTree")
  members  DepartmentMember[]

  @@index([orgId, path])
  @@index([parentId])
  @@map("departments")
}

model DepartmentMember {
  id           String   @id @default(uuid())
  departmentId String   @map("department_id")
  userId       String   @unique @map("user_id") // 1 user ? 1 dept (Q2 ch?t)
  // dept_role: leader / deputy / member. Partial unique index ensure
  // t?i ?a 1 leader + 1 deputy m?i dept (Q4 ch?t).
  deptRole     String   @default("member") @map("dept_role")
  joinedAt     DateTime @default(now()) @map("joined_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId, deptRole])
  @@map("department_members")
}

model PermissionGroup {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  name         String
  parentId     String?   @map("parent_id") // tree UI grouping, m?i node ??c l?p permission
  isSystem     Boolean   @default(false) @map("is_system") // Admin = protected, kh?ng x?a
  displayOrder Int       @default(0) @map("display_order")
  // FIX eng-review 2026-05-21: JSONB blob thay row-per-action (Issue 7).
  // Shape: { "<resource>": { "access": true, "create": false, "view_all": true, ... } }
  // 1 query l?y full matrix, parse in-memory, kh?ng N+1.
  grants       Json      @default("{}")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   PermissionGroup?  @relation("PermGroupTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children PermissionGroup[] @relation("PermGroupTree")
  users    User[]

  @@index([orgId])
  @@map("permission_groups")
}

