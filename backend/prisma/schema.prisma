// Phase ZaloAccounts redesign 2026-05-22 ? event log + checkpoint hybrid.
// M?I l?n status ??i (zaloPool emit) hook writeTransition() ? close record c?
// (UPDATE endedAt=NOW WHERE endedAt IS NULL) + insert record m?i (endedAt=NULL).
// Cron 5p checkpoint d?ng zaloPool.getAllStatuses() reconcile orphan open records
// sau crash. Uptime = SUM(connected duration) / window ? 100.
model ZaloAccountStatusLog {
  id        String    @id @default(uuid())
  orgId     String    @map("org_id")
  accountId String    @map("account_id")
  // 'connected' | 'disconnected' | 'auth_failed' | 'qr_pending' | 'expired'
  status    String
  startedAt DateTime  @map("started_at")
  // NULL = ?ang gi? status n?y. ??ng 1 record/account c? endedAt=NULL ? m?i th?i ?i?m.
  endedAt   DateTime? @map("ended_at")
  // 'login' | 'qr_scan' | 'reconnect_ok' | 'reconnect_failed' | 'disconnect'
  // | 'auth_fail' | 'session_expired' | 'crash_recovery' | 'checkpoint' | 'manual'
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account ZaloAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Query window uptime: WHERE accountId=? AND (endedAt IS NULL OR endedAt > since)
  @@index([accountId, startedAt])
  // Org-wide aggregate (team uptime)
  @@index([orgId, startedAt])
  // Find open record per account (partial index would be ideal ? Prisma kh?ng h? tr? inline)
  @@index([accountId, endedAt])
  @@map("zalo_account_status_log")
}

