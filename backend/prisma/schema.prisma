model UserPrivacySession {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  // Random 32-byte base64 token, set as HttpOnly cookie + sent qua axios interceptor (anh ch?t Q3 Issue 3).
  sessionToken   String    @unique @map("session_token")
  unlockedAt     DateTime  @default(now()) @map("unlocked_at")
  expiresAt      DateTime  @map("expires_at")
  // Idle timeout 30 ph?t: client request ??n ? update lastActivityAt; n?u now() - lastActivityAt > 30m ? server revoke.
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  ipHash         String?   @map("ip_hash") // audit cross-user (hash ch?ng PII leak)
  // Phase Privacy v2 2026-05-23: raw IP ?? user th?y session DEVICE c?a ch?nh m?nh (vd "192.168.1.200").
  // BE strict scope: ch? user xem session ownership c?a m?nh ? kh?ng cross-user leak.
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent") // audit + render "C?c C?c" / "Chrome" etc
  revokedAt      DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId, expiresAt])
  @@map("user_privacy_sessions")
}

// Phase Privacy OTP 2026-05-27 ? thay PIN t? setup b?ng OTP 4 s? g?i Zalo nick n?i b?.
model PrivacyOtpToken {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  otpHash                String    @map("otp_hash")
  sessionDurationMinutes Int       @map("session_duration_minutes")
  expiresAt              DateTime  @map("expires_at")
  verifyAttempts         Int       @default(0) @map("verify_attempts")
  lastSentAt             DateTime  @default(now()) @map("last_sent_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  usedAt                 DateTime? @map("used_at")
  ipAddress              String?   @map("ip_address")
  userAgent              String?   @map("user_agent")
  // 2026-06-06 ? t?ch 2 lu?ng (anh ch?t):
  //   'unlock'  = m? kho? XEM n?i dung ? verify t?o UserPrivacySession (c? session, ch?n duration).
  //   'enable'/'disable' = G?T b?t/t?t Ri?ng t? 1 nick ? verify CH? x?c nh?n m?, KH?NG t?o session.
  // nickId: bind OTP v?i ??ng nick ?ang g?t (ch?ng token-verify-nick-A-flip-nick-B). Null cho 'unlock'.
  action                 String    @default("unlock") @map("action")
  nickId                 String?   @map("nick_id")

  user User @relation("PrivacyOtpUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("privacy_otp_tokens")
}

