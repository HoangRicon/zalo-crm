  // Phase Onboarding v1 2026-05-24 ? email optional (sale VN d?ng S?T l? ch?nh, ?t/kh?ng c? email).
  // Unique partial: NULL kh?ng vi ph?m constraint, 2 user c?ng null OK.
  email                        String?              @unique
  passwordHash                 String               @map("password_hash")
  fullName                     String               @map("full_name")
  // RBAC Phase Ph?n Quy?n 2026-05-21: legacy `role` c?n gi? cho dual-read window 2 tu?n,
  // m? m?i ??c `permissionGroupId`. Sau migration verify OK (~2 tu?n) ? drop legacy column.
  role                         String               @default("member") // legacy: owner, admin, member
  permissionGroupId            String?              @map("permission_group_id")
  permissionGroup              PermissionGroup?     @relation(fields: [permissionGroupId], references: [id], onDelete: SetNull)
  departmentMember             DepartmentMember?
  // Phase Ri?ng T? ? visual privacy gate cho main nicks c?a user.
  // @deprecated 2026-06-06: chuy?n sang OTP qua Zalo, KH?NG c?n PIN. privacyPinHash th?nh
  //   dead column (gi? t?m, migration drop ?? task d?n ri?ng). privacyFailedCount/LockedUntil
  //   V?N D?NG cho OTP (sai 5 l?n ? lock 30 ph?t).
  privacyPinHash               String?              @map("privacy_pin_hash")
  privacyFailedCount           Int                  @default(0) @map("privacy_failed_count")
  privacyLockedUntil           DateTime?            @map("privacy_locked_until")
  privacySessions              UserPrivacySession[]
  // Phase Privacy v2 2026-05-23 ? hard cap s? nick user ???c flip sang 'main' (privacyMode).
  // Default 2, admin s?a qua /users/:id/max-privacy-nicks. BE reject 400 khi v??t.
  maxPrivacyNicks              Int                  @default(2) @map("max_privacy_nicks")
  // Phase Privacy v2 2026-05-23 ? nick "li?n l?c n?i b?" ? sale ch?n 1 nick m?nh OWN l?m
  // ??a ch? nh?n system notification (miss KH msg, mention, alert). FK SET NULL khi reassign owner.
  internalContactZaloAccountId String?              @map("internal_contact_zalo_account_id")
  internalContactNick          ZaloAccount?         @relation("UserInternalContact", fields: [internalContactZaloAccountId], references: [id], onDelete: SetNull)
  // Phase Internal Contact 2-method 2026-05-23 ? sale ch?n 1 trong 2 c?ch nh?n system notification:
  //   'crm_nick'       = d?ng nick OWN (l?u ? internalContactZaloAccountId)
  //   'personal_phone' = nh?p S?T Zalo c? nh?n kh?ng c? trong CRM (l?u ? internalContactPhone, normalize 84xxx)
  // null = ch?a setup. setupAt = l?c init handshake, confirmedAt = l?c g? verify code ??ng.
  internalContactMethod        String?              @map("internal_contact_method")
  internalContactPhone         String?              @map("internal_contact_phone")
  internalContactSetupAt       DateTime?            @map("internal_contact_setup_at")
  internalContactConfirmedAt   DateTime?            @map("internal_contact_confirmed_at")
  // Phase Onboarding v1 2026-05-24 ? first-run setup tracker.
  // passwordChangedAt = null ? FORCE ??i password l?n ??u. User c? backfill = createdAt.
  // onboardingStepsCompleted = JSON map { step: ISO timestamp | 'skipped' }.
  //   Keys: change_password, connect_nick, internal_contact, pin.
  // onboardingDismissedAt = sale ?n checklist ? collapse th?nh mini indicator.
  // jwtTokenVersion = bump khi ??i password ? revoke JWT c? (middleware check claim 'tv').
  passwordChangedAt            DateTime?            @map("password_changed_at")
  onboardingStepsCompleted     Json?                @map("onboarding_steps_completed")
  onboardingDismissedAt        DateTime?            @map("onboarding_dismissed_at")
  jwtTokenVersion              Int                  @default(0) @map("jwt_token_version")
  // Phase Onboarding v1 2026-05-24 ? S?T l?m identifier ??ng nh?p ch?nh cho sale VN.
  // Sale ?t/kh?ng d?ng email ? admin t?o user ch? v?i phone + password t?m. Login ch?p
  // nh?n c? email v?a phone (normalize 84xxx). Email v?n gi? cho admin/owner + user c?.
  phone                        String?              @unique
  // Phase user-create-with-zalo 2026-05-27 ? avatar l?y t? Zalo nick c?a sale l?c t?o
  // (findUser response tr? `avatar` URL). Hi?n th? trong UsersRbacView name column.
  avatarUrl                    String?              @map("avatar_url")
  // Phase status 4-state 2026-05-27 ? set l?c login th?nh c?ng, derive "Im l?ng" (>3d) vs "Ho?t ??ng".
  // null = ch?a t?ng login (ph?i h?p v?i passwordChangedAt=null ?? hi?n "Ch?a k?ch ho?t").
  lastLoginAt                  DateTime?            @map("last_login_at")
  isActive                     Boolean              @default(true) @map("is_active")
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")

  org                       Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team                      Team?                        @relation(fields: [teamId], references: [id])
  zaloAccounts              ZaloAccount[]
