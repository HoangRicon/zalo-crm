  @@unique([orgId, name])
  @@unique([sourceZaloLabelId]) // 1 Zalo label ? 1 CrmTag mirror
  @@index([orgId, category])
  @@index([orgId, groupId])
  @@index([managedBy, archivedAt])
  @@map("crm_tags")
}

// Tag group ? gom c?c CrmTag thu?c c?ng "nh?m" (formal h?n category string).
// 2 use case: (1) user-defined group, (2) zalo-managed group auto-t?o t? Zalo nick.
// managedBy='zalo_sync' + zaloAccountId set ? group ???c t?o+maintain t? ??ng khi sync.
model CrmTagGroup {
