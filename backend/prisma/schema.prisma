// dispatch qua nick ??. `ownerUserId` optional: folder c? nh?n c?a 1 sale CRM.
// BlockFolder ? Anh ch?t 2026-06-04: visibility l?u ? Folder, KH?NG ? Block.
// visibility='public' ? m?i sale trong org d?ng. 'private' ? ch? ownerUserId d?ng.
