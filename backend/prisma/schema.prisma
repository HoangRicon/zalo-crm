  @@index([orgId, requestedByUserId, requestedAt(sort: Desc)])
  @@index([contactId, requestedAt(sort: Desc)])
  @@index([requestedByUserId, noteSubmittedAt])
  @@index([expiresAt, autoReturnedAt])
  @@map("lead_requests")
}

model LeadPoolConfig {
  id                     String  @id @default(uuid())
  orgId                  String  @unique @map("org_id")
  enabled                Boolean @default(true)
  maxRequestsPerDay      Int     @default(10) @map("max_requests_per_day")
  cooldownMinutes        Int     @default(15) @map("cooldown_minutes")
  forgottenThresholdDays Int     @default(30) @map("forgotten_threshold_days")
  // JSON array of status keys to EXCLUDE from pool (sale ?ang ch?m t?t)
  excludedStatuses       Json    @default("[\"hot\",\"potential\",\"won\"]") @map("excluded_statuses")
  // Deprecated 2026-05-27 ? kept ?? backward-compat read. Code m?i d?ng autoReturnAfterMinutes.
  autoReturnAfterDays    Int     @default(7) @map("auto_return_after_days")
  // Phase Lead Pool v2 2026-05-27 ? anh ch?t granular ph?t, range 30 ph?t ? 7 ng?y (10080 ph?t).
  // Default 1440 ph?t = 1 ng?y. Lead b? hold l?u qu? th? sale kh?c ch? ? gi?m xu?ng cho rotate nhanh.
  autoReturnAfterMinutes Int     @default(1440) @map("auto_return_after_minutes")
  // Phase v2 ? lead ch? c? UID (no phone) kh?ng n?n v?o pool v? sale m?i kh?ng li?n l?c ???c
  // (UID per-viewer c?a sale c?, kh?ng d?ng ???c v?i nick m?i). Default true = b?t bu?c phone.
  // Admin t?t n?u mu?n force redistribute UID-only lead (sale t? g?i findUser qua nick m?nh).
  requirePhoneInPool     Boolean @default(true) @map("require_phone_in_pool")
  forceNoteBeforeNext    Boolean @default(true) @map("force_note_before_next")
  // JSON array: 'forgotten' | 'customer_list' | 'external_sync'
  enabledSources         Json    @default("[\"forgotten\",\"customer_list\"]") @map("enabled_sources")
  noteMinLength          Int     @default(20) @map("note_min_length")
  // 2026-05-29 Phase v2.B ? Cooldown sau note. Sale note xong ? KH n?y KH?NG v?o pool
  // ai kh?c trong N ng?y. Sale g?c v?n ch?m KH b?nh th??ng. Sale b?m "Tr? l?i pool" ?
  // bypass cooldown. Default 30 ng?y.
  cooldownAfterNoteDays  Int     @default(30) @map("cooldown_after_note_days")
  // 2026-05-29 Phase v2.I ? Self-reclaim lock. Sale tr? lead ? sale ?? KH?NG ???c nh?n
  // l?i ch?nh KH ?? trong N ng?y. Sale kh?c v?n xin ???c ngay. Ch?ng spam loop khi
  // sale g?c t? xin-tr?-xin l?i c?ng 1 KH. Default 7 ng?y.
  selfReclaimLockDays    Int     @default(7) @map("self_reclaim_lock_days")
  // 2026-05-28 ? JSON array string templates c?u ch?o m?c ??nh khi m? lead modal.
  // Placeholders h? tr?:
  //   {anh_chi}   ? "Anh" | "Ch?" | "Anh/Ch?" (capitalize, d?ng ??u c?u)
  //   {ac}        ? "anh" | "ch?" | "anh/ch?" (lowercase, d?ng gi?a c?u)
  //   {ten_kh}    ? t?n ri?ng KH (t? cu?i fullName, v? d? "Tran" cho "Tram Tran")
  //   {ten_em}    ? t?n ri?ng sale (t? cu?i fullName)
  // Empty array ? service fallback default 3 c?u hardcode. Admin PATCH config ?? th?m/s?a.
  greetingTemplates      Json    @default("[]") @map("greeting_templates")
  // 2026-06-19 (D) ? Pool ch? l?y lead t? c?c t?p KH (CustomerList) n?y. R?ng = m?i t?p
  // shareable_to_pool=true (h?nh vi c?). Ch? ?p khi ngu?n 'customer_list' ?ang b?t.
  sourceListIds          Json    @default("[]") @map("source_list_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("lead_pool_configs")
}

