// ---------------------------------------------------------------------------
// Sprint 5 R11 2026-07-21 ? AI Campaign Studio: Luu plan du?c AI sinh ra d?
// user review l?i v? apply th?nh BroadcastJob.
// ---------------------------------------------------------------------------

model CampaignPlan {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  createdById    String   @map("created_by_id")
  userGoal       String   @map("user_goal") @db.Text
  plan           Json // { audience, messages, schedule, kpi, risks }
  source         String // 'ai' | 'rule_based'
  appliedToJobId String?  @map("applied_to_job_id") // broadcast job n?u user apply
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("campaign_plans")
}

// 2026-07-22: Auto Reply Rules - rule-based auto chat khi KH nh?n ??n Zalo OA
model AutoReplyRule {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  oaAccountId   String?  @map("oa_account_id")
  name          String
  triggerType   String   @map("trigger_type")
  triggerValue  String   @map("trigger_value") @db.Text
  actionType    String   @map("action_type")
  actionContent String   @map("action_content") @db.Text
  priority      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  oaAccount ZaloAccount? @relation(fields: [oaAccountId], references: [id], onDelete: SetNull)

  @@index([orgId, enabled])
  @@index([oaAccountId])
  @@map("auto_reply_rules")
}

// 2026-07-22: Automation Execution Log - logs cho /reports/automation
model AutomationExecutionLog {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  oaAccountId String?   @map("oa_account_id")
  type        String
  jobId       String    @map("job_id")
  status      String    @default("running")
  sent        Int       @default(0)
  failed      Int       @default(0)
  // 2026-07-22 fix-zalo-crm-mvp-gaps#6: error message + per-recipient breakdown
  error       String?
  details     Json?
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  oaAccount ZaloAccount? @relation(fields: [oaAccountId], references: [id], onDelete: SetNull)

  @@index([orgId, startedAt])
  @@index([type])
  @@map("automation_execution_logs")
}

// 2026-07-22: Scheduled Template Send - g?i template 1 l?n theo l?ch
model ScheduledTemplateSend {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  oaAccountId  String    @map("oa_account_id")
  templateId   String    @map("template_id")
  contactIds   Json
  scheduledAt  DateTime  @map("scheduled_at")
  status       String    @default("pending")
  sentAt       DateTime? @map("sent_at")
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  oaAccount ZaloAccount     @relation(fields: [oaAccountId], references: [id], onDelete: Cascade)
  template  MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([orgId, status, scheduledAt])
  @@map("scheduled_template_sends")
}

// 2026-07-22: Sequence Membership - tracks KH enroll v?o sequence
model SequenceMembership {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  sequenceId  String    @map("sequence_id")
  contactId   String    @map("contact_id")
  oaAccountId String    @map("oa_account_id")
  currentStep Int       @default(0) @map("current_step")
  nextStepAt  DateTime? @map("next_step_at")
  status      String    @default("active")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sequence  AutomationSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact   Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  oaAccount ZaloAccount        @relation(fields: [oaAccountId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([status, nextStepAt])
  @@map("sequence_memberships")
}
