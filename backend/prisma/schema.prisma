// MessageTemplate ? c?u m?u sale g?i tay trong chat (g? "/" ?? ch?n).
// 2026-06-09 (Anh ch?t) N?NG C?P ??ng b? Kh?i: th?m folder + visibility per-item +
// tagIds (4 tag d? ?n) + contentRich {text, styles[]} (??nh d?ng Zalo: ??m/m?u/c?).
// C? ch? quy?n G?P CHUNG resource 'block' + m? h?nh "l? ch? HO?C c? grant":
//   ch? (createdById) t?o/s?a m?u RI?NG c?a m?nh KH?NG c?n grant; ??ng C?NG KHAI c?n grant block.create.
// `content` (plain) LU?N derive = contentRich.text ? route (d?ng search + ch?n chat).
// `ownerUserId` LEGACY (null=team c?): gi? dual-read, migrate ? visibility+createdById.
model MessageTemplate {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  ownerUserId      String?   @map("owner_user_id") // LEGACY: null=team. Gi? migrate dual-read.
  folderId         String?   @map("folder_id")
  // visibility cho m?u L? (folderId=null). M?u trong folder k? th?a folder.visibility.
  // Default 'private' (an to?n ? anh ch?t m?c ??nh Ri?ng t? cho m?u m?i).
  visibility       String    @default("private") // 'public' | 'private'
  name             String
  // T? kh?a g? t?t ? sale g? "/giaEGV" nh?y ??ng m?u (gi?ng shortcut Zalo/Telegram).
  // Lowercase kh?ng d?u c?ch. Popup match prefix theo shortcut TR??C, r?i t?n/n?i dung.
  shortcut         String?
  content          String // plain text ? LU?N = contentRich.text (derive ? route), d?ng search + ch?n chat
  contentRich      Json?     @map("content_rich") // { text: string, styles: [{st,start,len}] } ? ??nh d?ng Zalo
  // 2026-07-24 fix-batch#3: ?nh ?nh k?m m?u tin nh?n (FE upload FileReader -> base64, l?u tr?c ti?p v?o DB).
  // L? do: ?nh m?u th??ng nh? (< 500KB), tr?nh ph? thu?c S3/storage. C? th? migrate sang storage sau n?u c?n.
  // Gi?i h?n 1MB (sau decode) check ? route layer ?? tr?nh backup DB ph?ng to.
  imageBase64      String?   @map("image_base64") @db.Text
  category         String? // ph?n lo?i ch?c n?ng (FAQ/Ch?o/Ch?t) ? song song tagIds d? ?n
  tagIds           String[]  @default([]) @map("tag_ids") // 4 tag d? ?n + free-form
  usageCount       Int       @default(0) @map("usage_count")
  lastUsedAt       DateTime? @map("last_used_at")
  manualSendCount  Int       @default(0) @map("manual_send_count")
  lastManualSentAt DateTime? @map("last_manual_sent_at")
  archivedAt       DateTime? @map("archived_at") // soft delete
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  scheduledSends ScheduledTemplateSend[]

  org       Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     User?                  @relation(fields: [ownerUserId], references: [id])
  folder    MessageTemplateFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy User?                  @relation("MessageTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([orgId, ownerUserId])
  @@index([orgId, category])
  @@index([orgId, folderId])
  @@index([orgId, visibility])
  @@index([orgId, archivedAt])
  @@index([orgId, shortcut])
  @@index([tagIds], type: Gin)
  @@map("message_templates")
