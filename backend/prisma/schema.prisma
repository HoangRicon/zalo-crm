// ScoreSignalRule: rules ?? compute t?ng t?n hi?u (signal) th?nh delta ?i?m.
// M?i rule c? signalKey (vd "ask_price", "appointment_complete") + delta + cap +
// dimension target (engagement/intent/fit/velocity). Engine load rules per-org,
// apply khi detect signal trong chat content ho?c action event.
//
// Default seed (xem seed.ts) match v?i CEO review design:
//   intent.ask_price: +15, intent.appointment_complete: +35, ...
//   engagement.inbound_message: +3 (cap +15/ng?y), ...
//
// Admin c? th? tune t? Settings UI (PR6).
model ScoreSignalRule {
  id        String @id @default(uuid())
  orgId     String @map("org_id")
  signalKey String @map("signal_key") // e.g. "ask_price", "inbound_message"
  // Dimension target: engagement/intent/fit/velocity. Engine c?ng delta v?o
  // sub-score t??ng ?ng, sau aggregate qua weights ? final score.
  dimension String

  // Detection rule type:
  //   keyword     ? match keywords trong chat content (Vietnamese)
  //   action      ? trigger t? event (appointment_create, appointment_complete...)
  //   silent      ? silent decay (theo decayDay* trong config)
  //   profile     ? set 1 l?n khi profile match (budget/location/type)
  //   velocity    ? compute weekly (3 ng?y li?n ti?p, trend up...)
  ruleType String @map("rule_type")

  // Delta ?i?m khi rule match. Positive = t?ng, negative = gi?m.
  delta Int

  // Cap per day (null = kh?ng gi?i h?n). Vd "inbound_message" cap +15/ng?y.
  // Engine count signals/ng?y, kh?ng apply n?u v??t cap.
  capPerDay Int? @map("cap_per_day")

  // Cap total (null = kh?ng gi?i h?n). Vd "first_inbound" ch? apply 1 l?n lifetime.
  capTotal Int? @map("cap_total")

  // Keywords config (ch? ?p d?ng ruleType = "keyword"):
  // Format JSON: ["gi?", "bao nhi?u", "rao bao nhi?u"] ? match case-insensitive.
  keywords Json @default("[]")

  // Vietnamese label cho Score Explainability Modal hi?n th?.
  // Vd "H?i gi? r? r?ng", "Ho?n th?nh l?ch xem nh?".
  label String

  // Stage applicability ? rule ch? apply khi friend ? stage n?y.
  // null = apply m?i stage. Stage names: "M?i", "Ti?p c?n", "H?n g?p", ...
  applicableStages Json @default("[]") @map("applicable_stages")

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, signalKey])
  @@index([orgId, ruleType, enabled])
  @@map("score_signal_rules")
}

// StageTransitionRule: criteria ?? auto-promote Friend gi?a c?c stage.
// M?i row ??nh ngh?a fromStage ? toStage + criteria (JSON).
// Engine evaluate khi Friend.score thay ??i ho?c event x?y ra (appointment_create...).
//
// Default 7 rules (M?i?Ti?p c?n, Ti?p c?n?H?n g?p, ..., Ti?m n?ng?Ch?t).
// Khi criteriaMatch + autoPromote=true ? engine update statusId + stageEnteredAt,
// log ActivityLog v?i category='status_care', action='stage_promote_auto'.
//
// Manual promote (sale t? chuy?n) ? log v?i action='stage_promote_manual'.
model StageTransitionRule {
  id        String @id @default(uuid())
  orgId     String @map("org_id")
  fromStage String @map("from_stage") // t?n Status (vd "M?i")
  toStage   String @map("to_stage") // t?n Status (vd "Ti?p c?n")

  // Criteria JSON shape: {
  //   minEngagement?: number,
  //   minIntent?: number,
  //   minFit?: number,
  //   minVelocity?: number,
  //   minInboundCount?: number,
  //   requiresAction?: string[],  // ["appointment_create"] | ["appointment_complete"]
  //   minDaysInStage?: number,
  //   requiresManualConfirm?: boolean
  // }
  criteria Json @default("{}")

  // Auto-apply hay c?n manual confirm (vd N?ng ? Ti?m n?ng c?n sale verify).
  requiresManualConfirm Boolean @default(false) @map("requires_manual_confirm")

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fromStage, toStage])
  @@index([orgId, fromStage, enabled])
  @@map("stage_transition_rules")
}

// StuckThreshold: per-stage thresholds ?? ph?t hi?n ??nh tr?.
// Cron daily 6am scan t?t c? Friend, set stuckSince n?u ??t threshold.
// Stuck Detection Dashboard query `WHERE stuckSince IS NOT NULL` + group by stage.
//
// Default 5 thresholds:
//   M?i        > 7 ng?y  ? extra decay -2/ng?y
//   Ti?p c?n   > 14 ng?y ? extra decay -1/ng?y
//   H?n g?p    > 30 ng?y ? ?? xu?t video call
//   N?ng       > 21 ng?y ? c? ?u ??i th?ng n?y
//   Ti?m n?ng  > 14 ng?y ? g?i ?i?n tr?c ti?p
model StuckThreshold {
  id    String @id @default(uuid())
  orgId String @map("org_id")
  stage String // t?n Status (vd "M?i", "Ti?p c?n")

  // S? ng?y t?i thi?u trong stage ?? b? coi l? ??nh tr?.
  thresholdDays Int @map("threshold_days")

  // Extra decay/ng?y khi stuck (c?ng d?n v?i decayDay* trong ScoringConfig).
  extraDecayPerDay Int @default(0) @map("extra_decay_per_day")

  // NBA template key ? link t?i NbaTemplate.
  // Khi UI render Stuck Detection card ? fetch template + render personalized.
  nbaTemplateKey String? @map("nba_template_key")

  // Vietnamese label cho UI ("C?n li?n h? ngay", "?? xu?t video call", ...).
  alertLabel String @map("alert_label")

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, stage])
  @@index([orgId, stage, enabled])
  @@map("stuck_thresholds")
}

