// Appointment scheduled for a contact
// source='zalo' khi sync t? reminder Zalo client, source='manual' khi sale t?o trong CRM.
// externalRef = Zalo reminderId (unique per org ?? dedup khi reminder edit/fire l?i).
// zaloMessageId = FK m?m t?i Message.id c?a reminder card ? deep-link conversation.
model Appointment {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  contactId            String    @map("contact_id")
  assignedUserId       String?   @map("assigned_user_id")
  appointmentDate      DateTime  @map("appointment_date")
  appointmentTime      String?   @map("appointment_time")
  // 2026-05-21 "Nh?c h?n" refactor ? anh ch?t 1 modal cho create+edit:
  //   title       ? ti?u ?? (default = "G?i nh?c KH X")
  //   durationMin ? d? ki?n d?nh th?i gian (ph?t), endAt t?nh ng?m = startAt + duration
  //   location    ? ??a ?i?m (5 preset chips + smart suggest t? title)
  //   type        ? 4 values: call | message | meeting | follow_up
  title                String?
  durationMin          Int       @default(15) @map("duration_min")
  location             String?
  type                 String?
  status               String    @default("scheduled") // scheduled, completed, cancelled, no_show
  notes                String?
  reminderSent         Boolean   @default(false) @map("reminder_sent")
  // 2026-06-16: ?? g?i tin "link ??nh d?u ho?n th?nh/hu?" (sau gi? h?n) ch?a ? LEGACY (cron c? set true 1 l?n).
  // 2026-06-18 ??i sang ??m: gi? c?t n?y ?? migration c? kh?ng v?, logic m?i ??c actionPromptCount.
  actionPromptSent     Boolean   @default(false) @map("action_prompt_sent")
  // 2026-06-18 "Nh?c 3 l?n + digest tr??ng ph?ng":
  //   actionPromptCount    ? ?? g?i nh?c m?y l?n (0..3); cron t?ng SAU khi g?i OK (Lu?t D4).
  //   lastActionPromptAt   ? m?c g?i nh?c g?n nh?t.
  //   managerDigestedAt    ? l?n cu?i ??a l?ch n?y v?o digest tr??ng ph?ng (ch?ng g?i l?i trong ng?y).
  //   managerDigestFirstAt ? l?n ??U v?o digest; d?ng digest sau Organization.appointmentDigestStopDays ng?y (Lu?t D2).
  actionPromptCount    Int       @default(0) @map("action_prompt_count")
  lastActionPromptAt   DateTime? @map("last_action_prompt_at")
  managerDigestedAt    DateTime? @map("manager_digested_at")
  managerDigestFirstAt DateTime? @map("manager_digest_first_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  // Ngu?n + link Zalo
  source        String  @default("manual") // "manual" | "zalo"
  externalRef   String? @map("external_ref") // Zalo reminderId (params.actions[0].data.reminderId)
  zaloMessageId String? @map("zalo_message_id") // FK m?m ? Message.id (kh?ng cascade, gi? data n?u msg xo?)
  emoji         String? // ? ?? t? params ho?c default

  // Status audit ? track ai ??i status cu?i c?ng + l?c n?o (cron auto-flip kh?ng set)
  statusChangedByUserId String?   @map("status_changed_by_user_id")
  statusChangedAt       DateTime? @map("status_changed_at")
  statusChangedBy       User?     @relation("AppointmentStatusChanger", fields: [statusChangedByUserId], references: [id])

  org          Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?                   @relation(fields: [assignedUserId], references: [id])
  fromNotes    Note[]                  @relation("NoteAppointment")
  actionLinks  AppointmentActionLink[]

  @@unique([orgId, externalRef])
  @@index([source])
  @@index([orgId, appointmentDate])
  @@map("appointments")
}

// 2026-06-18 ? Short-link cho tin "Nh?c ho?n th?nh l?ch h?n". 1 m? ng?n / 1 l?ch (t?i d?ng c? 3 l?n nh?c).
// GET /a/:code ? ki?m expiresAt ? mint action token (exp=min(7d, expiresAt)) ? 302 sang /appointments/action?t=
// Ngu?n ch?n l? h?t-h?n l? c?t expiresAt ? ??y, KH?NG ph?i TTL token (ch?ng m?i l?n b?m ?? token 7 ng?y m?i).
model AppointmentActionLink {
