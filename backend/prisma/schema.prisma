// ????????????????????????????????????????????????????????????????????????????
// Phase Media Library 2026-06-11 (Anh ch?t qua office-hours + CEO/Eng/Design review)
// M? h?nh 2 t?ng (eng review E2/E3):
//   ? MediaBlob  = OBJECT TH? tr?n MinIO, dedup theo sha256 BYTES TH?T L?U.
//                  1 Asset c? nhi?u Blob variant (original / watermarked / compressed).
//   ? MediaAsset = DANH T?NH + metadata + quy?n (KH?NG mang minioKey tr?c ti?p).
//   Dedup ? t?ng Blob (hash), query kho ? t?ng Asset.
// INVARIANT: object immutable, "x?a" = archive (archivedAt), kh?ng 404 l?ch s? chat.
// (MediaUploadRef cache forward-ref ?? B? 2026-06-12: zca-js kh?ng forward ???c media
//  ? lu?n g?i l? ???ng B, ref kh?ng bao gi? d?ng. Xem reference_zalo_forward_media_impossible.)
// ????????????????????????????????????????????????????????????????????????????

// MediaBlob ? object th? tr?n MinIO. Dedup theo contentHash (sha256 bytes ?? l?u).
// 1 asset ? nhi?u blob variant. G?i N l?n c?ng 1 variant = 1 object duy nh?t.
model MediaBlob {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  assetId     String   @map("asset_id")
  // sha256 c?a BYTES TH?T L?U l?n MinIO (?? n?n n?u l? variant compressed/original-n?n).
  contentHash String   @map("content_hash")
  variantType String   @default("original") @map("variant_type") // 'original' | 'watermarked' | 'compressed'
  minioKey    String   @map("minio_key") // key tr?n MinIO: media/{contentHash}{ext}
  publicUrl   String   @map("public_url")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  width       Int?
  height      Int?
  durationSec Int?     @map("duration_sec") // video
  createdAt   DateTime @default(now()) @map("created_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  asset MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Dedup key: c?ng org + c?ng bytes = 1 blob. statObject + upsert ch?ng tr?ng.
  @@unique([orgId, contentHash])
  @@index([assetId])
  @@map("media_blobs")
}

// MediaAsset ? danh t?nh 1 "t?m ?nh/file" trong kho (vd "B?ng gi? EGV").
// Pattern copy t? MessageTemplate (org/owner/visibility/createdBy/tagIds/usageCount).
model MediaAsset {
  id                  String    @id @default(uuid())
  orgId               String    @map("org_id")
  kind                String // 'image' | 'video' | 'file'
  name                String
  // ownerUserId: ch? s? h?u (sale l?u/t?i l?n). NULL = t?i s?n chung org.
  ownerUserId         String?   @map("owner_user_id")
  // visibility: 'private' (ch? owner) | 'public' (c? org). M?c ??nh private ? fail-closed.
  visibility          String    @default("private")
  // source: ph?n bi?t ngu?n n?p ?? audit privacy. 'upload' = sale/admin t?i l?n;
  // 'saved_from_chat' = l?u t? bong b?ng chat (c? th? ch?a PII kh?ch).
  source              String    @default("upload")
  // Nick Zalo NGU?N c?a ?nh l?u t? chat ? ?? HI?N TH? "?nh t? nick n?o" (m?i nick, c?
  // nick th??ng l?n Ri?ng t?). 2026-06-15: tr??c ??y CH? ghi khi nick Ri?ng t?; nay ghi
  // cho M?I ?nh l?u t? chat. ?nh upload tay = null (ngu?n = "T?i l?n th? c?ng" + sale).
  sourceZaloAccountId String?   @map("source_zalo_account_id")
  // 2026-06-15: T?CH c? ENFORCE privacy kh?i nick-ngu?n-hi?n-th?. true CH? khi ?nh l?u t?
  // nick Ri?ng t? (privacyMode='main') ? gate confirmShare khi public + c?nh b?o D11. Tr??c
  // ??y code suy c? t? `!!sourceZaloAccountId`; nick th??ng gi? c?ng c? id n?n PH?I ??c c? n?y.
  sourceIsPrivateNick Boolean   @default(false) @map("source_is_private_nick")
  folderId            String?   @map("folder_id") // MediaAlbum d?ng l?m "th? m?c" (parentId=null)
  tagIds              String[]  @default([]) @map("tag_ids") // tag d? ?n (EGV/HS...) ? Gin index
  originalFilename    String?   @map("original_filename")
  thumbnailUrl        String?   @map("thumbnail_url") // video thumbnail
  // Watermark per-?nh (G?2): B?T/T?T + g?c + ?? m?. Khi B?T, g?i ?i d?ng blob 'watermarked'.
  watermarkEnabled    Boolean   @default(false) @map("watermark_enabled")
  watermarkPosition   String    @default("bottom-right") @map("watermark_position") // bottom-right|bottom-left|top-right|top-left|center
  watermarkOpacity    Float     @default(0.65) @map("watermark_opacity")
  usageCount          Int       @default(0) @map("usage_count")
  lastUsedAt          DateTime? @map("last_used_at")
  archivedAt          DateTime? @map("archived_at") // soft delete = D?U TH?NG R?C ? KH?NG x?a object MinIO
  // G?13a (2026-06-12): ai b? asset v?o th?ng r?c (audit + scope sale). NULL = ch?a t?ng/?? kh?i ph?c.
  trashedById         String?   @map("trashed_by_id")
  createdById         String?   @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  org               Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner             User?             @relation("MediaAssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy         User?             @relation("MediaAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  folder            MediaAlbum?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // 2026-06-15: relation t?i nick ngu?n ?? Prisma `include` join displayName 1 query (ch?ng
  // N+1 khi list 60-200 ?nh hi?n "nick n?o"). SetNull: nick x?a ? v?n gi? ?nh, m?t t?n nick.
  sourceZaloAccount ZaloAccount?      @relation("MediaAssetSourceNick", fields: [sourceZaloAccountId], references: [id], onDelete: SetNull)
  blobs             MediaBlob[]
  albumItems        MediaAlbumItem[]
  usageEvents       MediaUsageEvent[]

  @@index([orgId, kind])
  @@index([orgId, visibility])
  @@index([orgId, ownerUserId])
  @@index([orgId, archivedAt])
  @@index([folderId])
  @@index([sourceZaloAccountId])
  @@index([tagIds], type: Gin)
