  eventFilter             Json?     @map("event_filter")
  bindingKind             String    @map("binding_kind") // 'sequence' | 'block' | 'broadcast'
  sequenceId              String?   @map("sequence_id")
  blockId                 String?   @map("block_id")
  broadcastId             String?   @map("broadcast_id")
  segmentSpec             Json?     @map("segment_spec")
  ruleOverrides           Json?     @map("rule_overrides")
  enabled                 Boolean   @default(true)
  // Phase Friend Invite 2026-05-28 ? successor sequence + greeting template
  successorSequenceId     String?   @map("successor_sequence_id")
  greetingTemplate        String?   @map("greeting_template") @db.Text
  // Wave 2 2026-05-29 ? per-trigger welcome probe (split from Org-level)
  welcomeMessageTemplate  String?   @map("welcome_message_template") @db.Text
  // FIX 2026-06-08 (Anh ch?t): default 60?1. S?n welcomeMinFloorSeconds ?? b? kh?i
  // welcome-probe ? ?? tr? welcome = ??NG gi? tr? n?y. Anh ch?nh khi t?o trigger.
  welcomeDelaySeconds     Int       @default(1) @map("welcome_delay_seconds")
  // ?? C?u tr?c 5 tin 2026-06-04 (I10 ? Anh ch?t qua /design-html) ??
  // Tin 2 ? C?m ?n KH ?? ??ng ? KB ? g?i khi event friend_accepted (KH?C welcome=Tin1
  // g?i sau khi m?i, kh?ng ch? accept). thankYouDelay t?nh t? l?c KH accept.
  thankYouTemplate        String?   @map("thank_you_template") @db.Text
  thankYouDelaySeconds    Int       @default(60) @map("thank_you_delay_seconds")
  // Tin 3 ? Nh?c KH ??ng ? KB sau N ng?y (cron qu?t, t? b? qua n?u ?? accept).
  remindTemplate          String?   @map("remind_template") @db.Text
  remindDelayDays         Int       @default(3) @map("remind_delay_days")
  // Tin 4 ? Khi KH t? ch?i KB ? g?i qua h?p ng??i l? ngay khi event friend_rejected.
  rejectedTemplate        String?   @map("rejected_template") @db.Text
  // 4 c? b?t/t?t t?ng tin (L?i m?i = greetingTemplate lu?n b?t bu?c, kh?ng c? c?).
  // Tin 1 Ch?o m?ng / Tin 2 C?m ?n / Tin 3 Nh?c / Tin 4 T? ch?i.
  enableWelcome           Boolean   @default(true) @map("enable_welcome")
  enableThankYou          Boolean   @default(true) @map("enable_thank_you")
  enableRemind            Boolean   @default(true) @map("enable_remind")
  enableRejectedFollowUp  Boolean   @default(false) @map("enable_rejected_follow_up")
  // ?? #1 2026-06-06 (Anh ch?t): 2 c?ng t?c b?m ?u?i theo tr?ng th?i k?t b?n ??
  // followUpStrangerEnabled: b?m ?u?i c? khi KH CH?A ??ng ? k?t b?n (g?i qua h?p
  //   ng??i l?). B?T = h?nh vi c? (spam h?t lu?ng). T?T = ch? b?m ?u?i sau khi accept.
  // followUpFriendEnabled: b?m ?u?i khi KH ?? l? b?n ? k?ch ho?t khi nh?n event
  //   accept th?t t? Zalo (onFriendAccepted). T?T = KH duy?t c?ng kh?ng b?m ?u?i.
  // Default c? 2 = true ? M?c ti?u c? gi? nguy?n h?nh vi.
  followUpStrangerEnabled Boolean   @default(true) @map("follow_up_stranger_enabled")
  followUpFriendEnabled   Boolean   @default(true) @map("follow_up_friend_enabled")
  // ?? T? ??t t?n g?i nh? (Zalo alias) 2026-06-19 (Anh ch?t) ??
  // changeFriendAlias(alias, friendId=UID) KH?NG c?n friendship ? ??t NGAY khi findUser ra
  // UID trong request_friend, cho TO?N B? t?p c? Zalo ("??t h?t"). LU?N ?? theo m?u.
  // aliasTemplate d?ng bi?n render-template (vd {zalo_name} {trigger_project} {income} {phone}).
  // {zalo_name}=t?n Zalo TH?T (CEO ch?t, ko ph?i t?n import). {trigger_project}=projectAbbr.
  autoAliasEnabled        Boolean   @default(false) @map("auto_alias_enabled")
  aliasTemplate           String?   @map("alias_template") @db.Text
  projectAbbr             String?   @map("project_abbr")
  // Th?ng b?o n?i b? per-event: { "<eventKey>": { "owner": bool, "manager": bool, "zaloGroup": bool } }
  // eventKey: welcome|thankYou|remind|rejected|reply|reactionPositive|reactionNegative|lead|block|friendAccept|friendReject.
  // owner = Sale ph? tr?ch nick (L?M TH?T). manager auto org-tree (RBAC M2). zaloGroup = UID nh?p Settings.
  notifyChannels          Json?     @map("notify_channels")
  // ?? CareSession (Phi?n ch?m s?c) 2026-06-07 ? ?i?u ki?n ??NG phi?n per-M?c-ti?u ??
  // { onStatusIds: [...], onFriendTagIds: [...], onCrmTagIds: [...], silenceDays: 7 }
  // Snapshot v?o CareSession.closeConditions khi t?o phi?n ? kh?ch ? 2 M?c ti?u ?p 2 lu?t ri?ng.
  closeConditions         Json?     @map("close_conditions")
  state                   String    @default("draft") // 'draft' | 'active' | 'paused' | 'cancelling' | 'cancelled' | 'completed' (UI derive 'scheduled' khi state=draft + scheduledAt set)
  // BE T4 2026-05-30 ? friend-invite l?n l?ch h?n gi?. NULL = activate ngay khi g?i /activate.
  scheduledAt             DateTime? @map("scheduled_at")
  // P2 Wave 4 2026-06-02 ? T?m d?ng c? th?i h?n. NULL = pause v? h?n (user ph?i b?m "Ti?p t?c").
  // Set khi g?i /pause v?i body { ttlHours }. Cron sweep m?i 1 ph?t auto-flip state='paused'?'active'
  // khi pausedUntil <= NOW() (??ng th?i reset pausedUntil=NULL).
  pausedUntil             DateTime? @map("paused_until")

  // ?? Lu?ng M?c Ti?u rebuild 2026-06-01 (Marketing BullMQ Rebuild M0) ??
  // P1: Delay sau khi g?i l?i m?i ? step 1 b?m ?u?i (ph?t). C?u h?nh per-trigger qua Wizard B3.
  sequenceStartDelayMinutes   Int     @default(60) @map("sequence_start_delay_minutes")
  // 2026-06-16 ? b?n GI?Y c?a delay tr?n (Wizard B3 cho nh?p gi?y, m?c ??nh 10s).
  // NULL = M?c ti?u c? ch?a c?u h?nh gi?y ? fallback sequence_start_delay_minutes ? 60.
  // M?i consumer ?u ti?n c?t n?y khi != NULL. 0 = g?i ngay (kh?ng delay).
  sequenceStartDelaySeconds   Int?    @map("sequence_start_delay_seconds")
  // P2: Pause khi KH t??ng t?c (gi?). Reply trong window ? reset (P2.1).
