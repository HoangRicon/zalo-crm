// CRM-style notes on a contact ? Facebook-comment-like with flat thread (parentNoteId nullable, depth=1).
// Manager c? th? reply v?o note c?a sale. Reaction emoji per (note, user, emoji).
// AI c? th? parse note body ("Th? 6 g?i l?i kh?ch") ? suggest Appointment (linked via Appointment.noteId).
model Note {
  id                     String   @id @default(uuid())
  orgId                  String   @map("org_id")
  contactId              String   @map("contact_id")
  parentNoteId           String?  @map("parent_note_id") // null = root note, set = reply (ch? 1 c?p)
  authorUserId           String   @map("author_user_id")
  body                   String   @db.Text
  // Khi user b?m "?? T?o l?ch h?n" tr?n note ? set FK t?i appointment ???c t?o.
  // Cho ph?p hi?n badge "?? t?o l?ch" tr?n note + tr?nh t?o tr?ng.
  suggestedAppointmentId String?  @map("suggested_appointment_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author      User           @relation("NoteAuthor", fields: [authorUserId], references: [id])
  parent      Note?          @relation("NoteThread", fields: [parentNoteId], references: [id], onDelete: Cascade)
  replies     Note[]         @relation("NoteThread")
  reactions   NoteReaction[]
  appointment Appointment?   @relation("NoteAppointment", fields: [suggestedAppointmentId], references: [id], onDelete: SetNull)

  @@index([orgId, contactId, createdAt])
  @@index([parentNoteId])
  @@map("notes")
}

// CRM tag ? tag SYSTEM-LEVEL do org t? ??nh ngh?a (vd "vip", "quan_t?m", "hot_lead").
// Kh?c ZaloLabel (Zalo native, sync 2-way v?i Zalo SDK).
// Contact.tags JSON array of strings tham chi?u CrmTag.name. N?u name kh?ng match
// trong CrmTag table ? v?n cho l?u (free-text) nh?ng FE hint user th?m v?o table.
model CrmTag {
  id                String    @id @default(uuid())
  orgId             String    @map("org_id")
  name              String // unique per org, d?ng l?m reference key
  color             String    @default("#90A4AE") // hex color
  emoji             String? // optional unicode emoji prefix
  description       String? // m? t? m?c ??ch, vd "Kh?ch quan t?m d? ?n EGV"
