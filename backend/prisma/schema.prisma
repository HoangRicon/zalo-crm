// Individual message within a conversation
model Message {
  id                  String    @id @default(uuid())
  conversationId      String    @map("conversation_id")
  zaloMsgId           String?   @map("zalo_msg_id")
  // Numeric Snowflake t? Zalo server ? primary sort key (match 100% Zalo Web).
  // sentAt gi? l?m display + fallback cho CRM-sent ch?a echo. KH?NG d?ng sentAt l?m
  // primary order v? self-listen events ??i khi thi?u `ts` ? Date.now() fallback l?ch ~30s.
  zaloMsgIdNum        BigInt?   @map("zalo_msg_id_num")
  senderType          String    @map("sender_type") // self, contact
  senderUid           String?   @map("sender_uid")
  senderName          String?   @map("sender_name")
  content             String?
  contentType         String    @default("text") @map("content_type") // text, image, file, sticker, voice, video, link
  attachments         Json      @default("[]")
  quote               Json?     @map("quote")
  albumKey            String?   @map("album_key") // Zalo group_layout_id ? identifies multi-image albums
  albumIndex          Int?      @map("album_index") // 0-based position within album
  albumTotal          Int?      @map("album_total") // total items in album
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  // Edit message audit (2026-05-21) ? zca-js kh?ng support edit th?t, edit ch? ?p d?ng tr?n CRM.
  // Khi s?a: l?u content c? v?o originalContent (l?n ??u) + set editedAt = now.
  originalContent     String?   @map("original_content")
  editedAt            DateTime? @map("edited_at")
  // Zalo client message id (2026-05-21) ? KH?C zaloMsgId (server snowflake). C?n cho api.undo
  // (Zalo expect c? msgId + cliMsgId). Tin c? tr??c migration ch?a c? column n?y ? null.
  zaloCliMsgId        String?   @map("zalo_cli_msg_id")
  sentAt              DateTime  @map("sent_at")
  // Read receipts (2026-05-21 Wave 1+2 ? wire `delivered_messages` + `seen_messages`
  // SDK events). C? 2 ch? set cho tin OUTGOING (senderType='self'); KH-side lu?n null.
  //   deliveredAt ? Zalo server confirm device KH ?? nh?n packet (1 tick x?m)
  //   seenAt      ? KH m? conversation ??c tin (2 tick xanh)
  deliveredAt         DateTime? @map("delivered_at")
  seenAt              DateTime? @map("seen_at")
  repliedByUserId     String?   @map("replied_by_user_id")
  // Phase metrics layer 2026-05-22: ph?n bi?t ngu?n g?i cho automation rate-limit + dashboard.
  // 'user' = sale g?i qua CRM UI HO?C sync v? t? Zalo native (default ? backward compat)
  // 'automation' = bot/sequence/broadcast/NBA suggest g?i qua engine
  // 'system' = CRM internal (reminder card, system notice ? ch?a d?ng, reserved)
  sentVia             String    @default("user") @map("sent_via")
  // M53 (2026-05-30): isLocal=true cho message KH?NG g?i qua Zalo SDK (virtual conv ho?c AI assistant).
  // Worker/metrics/automation aggregator ph?i filter WHERE isLocal=false. zaloMsgId synthetic 'local:{cuid}' ?? n? NULL collision.
  // senderType c? th?m value 'ai_assistant' khi AI tr? l? reply trong virtual chat.
  // metadata Json l?u extracted entities AI suggest: { extracted: {...}, confidenceScore, missingFields }
  //   + M11 (2026-06-02): metadata.sender = { kind, name, detail?, sequenceId?, stepIdx? }
  isLocal             Boolean   @default(false) @map("is_local")
  metadata            Json?
  // ?? Mention metadata Anh ch?t 2026-06-03 ??
  // Persist Zalo SDK TGroupMessage.mentions ?? FE render ch?nh x?c theo
  // pos+len thay v? ?o?n regex. Ch? group message c? mentions; user 1-1 null.
  // Shape: [{ uid: string; pos: number; len: number; type: 0 | 1 }]
  //   pos = v? tr? k? t? @ trong content
  //   len = ?? d?i full mention (k?m c? " - Hs Holding")
  //   type = 0=user | 1=all (@all)
  mentions            Json?
  // ?? Lu?ng M?c Ti?u M10/M11 attribution 2026-06-01 ??
  // automationTaskId = BullMQ jobId (string, KH?NG FK v? AutomationTask ?? drop).
  // Pattern: `${triggerId}-${contactId}-${stepIdx}` (DASH, BullMQ v5 c?m `:` ? POC 2026-06-01).
  // automationStepIndex = b??c th? m?y trong sequence (1,2,3...) cho per-step funnel M10.
  automationTaskId    String?   @map("automation_task_id")
  automationStepIndex Int?      @map("automation_step_index")
  // Mobile App 2026-06-15 (BE-3) ? idempotency: uuid app t? sinh, g?i 1 l?n / 1 tin.
  // Dedup TR??C khi g?i sang Zalo (zaloMsgId ch? c? SAU khi Zalo tr? v? ? qu? mu?n cho retry).
  clientEchoId        String?   @map("client_echo_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  repliedBy    User?             @relation("RepliedMessages", fields: [repliedByUserId], references: [id])
  reactions    MessageReaction[]

  @@unique([conversationId, zaloMsgId])
  // BE-3 idempotency ? 1 echoId duy nh?t / conversation. Multiple NULL cho ph?p (tin c?).
  @@unique([conversationId, clientEchoId])
  @@index([conversationId, albumKey])
  // Composite index cho sort theo Zalo Snowflake ? primary order khi list messages.
  @@index([conversationId, zaloMsgIdNum(sort: Desc)])
  // Phase metrics 2026-05-22: aggregate query per nick per day per category
  @@index([conversationId, sentAt, senderType, sentVia])
  // M10/M11 ? attribution + filter
  @@index([automationTaskId, sentAt])
  @@index([sentVia, conversationId])
  @@map("messages")
}

